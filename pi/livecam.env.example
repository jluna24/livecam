# Copiar a ~/livecam/livecam.env en la Pi (fuera de git) y llenar con `tofu output`.
CANAL=livecam-pi5-cam-01
AWS_DEFAULT_REGION=us-east-2
AWS_IOT_CORE_CREDENTIAL_ENDPOINT=xxxxxxxxxxxxx.credentials.iot.us-east-2.amazonaws.com
AWS_IOT_CORE_ROLE_ALIAS=livecam-pi-master
AWS_IOT_CORE_CERT=/home/jluna/livecam/certs/pi.crt
AWS_IOT_CORE_PRIVATE_KEY=/home/jluna/livecam/certs/pi.key
# Video (opcional)
W=1280
H=720
FPS=15
KBPS=1500
